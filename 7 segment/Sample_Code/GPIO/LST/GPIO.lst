 373          void Display_Data(unsigned char val)
 374          {
 375   1              static unsigned int Seg_Counter = 0;
 376   1                      clear_NUMS();
 377   1              if(val < 25)
 378   1              {
 379   2                      SEG2 = 0;               
 380   2                      SEG1 = 1;
 381   2                      Display_Digit(13);       //L
 382   2                      Timer0_Delay1ms(4);
 383   2                      SEG1 = 0;               
 384   2                      SEG2 = 1;
 385   2                      Display_Digit(12);  //o
 386   2                      Timer0_Delay1ms(5);     
 387   2              }
 388   1              else if(val < 72 || val == 88)
 389   1              {       
 390   2                      SEG2 = 0;               
 391   2                      SEG1 = 1;
 392   2                      Display_Digit(val % 10);        
 393   2                      Timer0_Delay1ms(4);
 394   2                      SEG1 = 0;               
 395   2                      SEG2 = 1;
 396   2                      Display_Digit(val / 10);
 397   2                      Timer0_Delay1ms(5);
 398   2              }
 399   1              else if(val >= 72 && val < 96)
 400   1              {
 401   2                      SEG2 = 0;               
 402   2                      SEG1 = 1;
 403   2                      Display_Digit(15);       //H
 404   2                      Timer0_Delay1ms(4);
 405   2                      SEG1 = 0;               
 406   2                      SEG2 = 1;
 407   2                      Display_Digit(14);  //i
 408   2                      Timer0_Delay1ms(5);     
 409   2              }
 410   1      
 411   1              else if(val >= 96)
 412   1              {
 413   2                      SEG2 = 0;               
 414   2                      SEG1 = 1;
 415   2                      Display_Digit(11);      
 416   2                      Timer0_Delay1ms(4);
 417   2                      SEG1 = 0;               
